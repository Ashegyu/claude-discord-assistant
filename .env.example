# ── 필수 ──
ANTHROPIC_API_KEY=sk-ant-...            # 구독 크레딧 연결된 Console 조직의 키
DISCORD_TOKEN=                           # 디스코드 개발자 포털 → Bot → Reset Token
DISCORD_OWNER_ID=                        # 내 디스코드 사용자 ID (개발자 모드 → 프로필 우클릭 → ID 복사)
DISCORD_HOME_CHANNEL_ID=                 # 알림 받을 채널 ID (비우면 DM으로)

# ── Gmail (읽기 전용, IMAP) ──
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=                      # 구글 계정 → 보안 → 2단계 인증 → 앱 비밀번호 (16자리)

# ── 구글 캘린더 (읽기만이면 이것만) ──
GOOGLE_CALENDAR_ICS_URLS=                # 캘린더 설정 → '비공개 주소(iCal 형식)', 여러 개면 쉼표
# 일정 추가·드라이브 검색은 deploy/google_auth.py 로 data/google_token.json 발급

# ── GitHub / Notion ──
GITHUB_TOKEN=                            # Fine-grained: 대상 레포 Contents·Issues 읽기, Issues 쓰기, Actions 쓰기(워크플로 실행)
NOTION_TOKEN=                            # 'daily-digest' Notion 통합 시크릿 재사용 가능

# ── 카카오 (장소 검색 / 나에게 보내기) ──
KAKAO_REST_API_KEY=
KAKAO_REFRESH_TOKEN=                     # daily-digest와 따로 발급 권장 (kakao_init.py 한 번 더 실행)
KAKAO_CLIENT_SECRET=

# ── Microsoft To Do (갤럭시 삼성 리마인더 연동) ──
MS_CLIENT_ID=                            # Azure 앱 등록의 '애플리케이션(클라이언트) ID'. 그다음 deploy/ms_auth.py 한 번 실행
MS_TENANT=consumers                      # 개인 계정(outlook/hotmail/live)은 consumers 그대로

# ── 봇 생존 감시 (healthchecks.io 무료) ──
HEALTHCHECK_URL=                         # https://hc-ping.com/<uuid>  (Period 5분, Grace 10분, Discord 연동)

# ── 웹 카드 (카카오 JavaScript SDK) ──
KAKAO_JS_KEY=                            # 카카오 앱의 JavaScript 키 (공개돼도 되는 키). 콘솔에 사이트 도메인 등록 필요

# ── 부산 실시간 (공공데이터포털) ──
DATA_GO_KR_KEY=                          # 일반 인증키(Decoding). '부산버스정보시스템', '기상청_기상특보 조회서비스' 활용신청
